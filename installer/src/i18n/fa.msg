# Sinux installer - Farsi catalog (raw UTF-8)
# The build script also produces fa-console.msg (pre-shaped, visual order) for the VGA console.
APP_TITLE=نصب‌کننده سینوکس ۱٫۱٫۰
INTRO=به نصب‌کننده ترمینالی سینوکس خوش آمدید.\n\nاین رسانه فقط یک لینوکس زنده کوچک برای نصب است.\nآنچه روی دیسک نصب می‌شود، کرنل سینوکس است (سیستمی فقط‌ترمینالی که از صفر نوشته شده).\n\nتمام اطلاعات دیسک هدف پاک خواهد شد. یک جدول GPT سازگار با BIOS و UEFI ساخته می‌شود.\nدر سخت‌افزار واقعی باید Secure Boot خاموش باشد.
ABOUT_TITLE=درباره
ABOUT_TEXT=نصب‌کننده سینوکس ۱٫۱٫۰\n\nپروژه اصلی: github.com/SinuxProject/Sinux\nکرنل نصب‌شده: سینوکس x86_64 با Multiboot2 (فقط شل ترمینال)\nسیستم زنده نصب‌کننده: لینوکس مینیمال دبیان ۱۳، فقط متنی\nچیدمان دیسک: GPT / ۱ مگابایت بوت BIOS + ۱۲۸ مگابایت EFI + ریشه ext2\nپشتیبانی بوت: BIOS قدیمی و UEFI x86_64\n\nاین نصب‌کننده دوزبانه است: انگلیسی یا فارسی را از منوی بوت انتخاب کنید.
MAIN_TITLE=نصب‌کننده سینوکس - منوی اصلی
MAIN_TEXT=یک گزینه را با کلید‌های جهت‌دار انتخاب کرده و Enter بزنید.
ACT_INSTALL=نصب سینوکس روی دیسک
ACT_LANG=تغییر زبان / Change language
ACT_RESCUE=باز کردن شل تعمیرات
ACT_REBOOT=راه‌اندازی مجدد دستگاه
ACT_POWEROFF=خاموش کردن دستگاه
ACT_ABOUT=درباره این نصب‌کننده
ACT_EXIT=خروج از نصب‌کننده
LANG_TITLE=زبان / Language
LANG_TEXT=زبان نصب‌کننده را انتخاب کنید.
LANG_EN=انگلیسی (English)
LANG_FA=فارسی
DISK_TITLE=انتخاب دیسک هدف
DISK_TEXT=دیسی را انتخاب کنید که پاک شده و به سیستم سینوکس تبدیل می‌شود.
NO_DISK=هیچ دیسک مناسبی پیدا نشد. درایور ذخیره‌سازی را بررسی کنید یا از شل تعمیرات استفاده کنید.
WARN_TITLE=هشدار - از دست رفتن اطلاعات
WARN_TEXT=تمام اطلاعات روی دیسک انتخاب‌شده نابود می‌شود.\n\nدیسک به صورت GPT با سه پارتیشن دوباره‌سازی می‌شود:\n  ۱  ۱ مگابایت  پارتیشن بوت BIOS\n  ۲  ۱۲۸ مگابایت پارتیشن EFI (FAT32)\n  ۳  باقی‌مانده ریشه سینوکس (پیش‌فرض ext2)\n\nاین کار قابل بازگشت نیست.
CONFIRM_TITLE=تأیید دیسک
CONFIRM_TEXT=برای تأیید، نام دقیق دیسک را تایپ کنید (مثلا sda یا nvme0n1).
CONFIRM_BAD=نام تایپ‌شده مطابقت نداشت. هیچ تغییری انجام نشد.
FS_TITLE=فایل‌سیستم ریشه
FS_TEXT=فایل‌سیستم پارتیشن ریشه سینوکس را انتخاب کنید.
FS_EXT2=ext2 (پیشنهادی - قابل خواندن توسط درایور ext2 سینوکس)
FS_EXT4=ext4 (GRUB بوت می‌کند ولی کرنل سینوکس نمی‌خواند)
HOST_TITLE=نام میزبان
HOST_TEXT=یک نام میزبان برای سیستم نصب‌شده وارد کنید.
PLAN_TITLE=برنامه نصب
PLAN_OK=نصب اکنون آغاز شود؟
STEP_PART=ساخت جدول پارتیشن GPT
STEP_FORMAT=فرمت کردن پارتیشن‌های EFI و ریشه
STEP_COPY=کپی کردن کرنل سینوکس و فایل‌های سیستم
STEP_BIOS=نصب GRUB برای BIOS قدیمی
STEP_UEFI=نصب GRUB برای UEFI
STEP_DONE=نوشتن پیکربندی بوت و پایان کار
DRY_TITLE=اجرای آزمایشی
DRY_TEXT=اجرای آزمایشی: هیچ دیسکی تغییر نکرد. دستورات برنامه‌ریزی‌شده در لاگ نمایش داده می‌شود.
DONE_TITLE=نصب کامل شد
DONE_TEXT=سینوکس با موفقیت نصب شد.\n\nپیش از راه‌اندازی مجدد، رسانه نصب را خارج کنید.\nدر سخت‌افزار واقعی: Secure Boot را خاموش کنید و دیسک را در حالت BIOS یا UEFI بوت کنید.\n\nکرنل سینوکس وارد شل ترمینال داخلی خود می‌شود.
ERR_TITLE=خطا
CANCELLED=عملیات لغو شد. هیچ تغییری انجام نشد.
YES_LABEL=بله
NO_LABEL=خیر
OK_LABEL=تأیید
BACK_LABEL=بازگشت
REBOOT_Q=اکنون راه‌اندازی مجدد شود؟
SHELL_TITLE=شل تعمیرات
SHELL_TEXT=شل تعمیرات bash آغاز می‌شود. برای بازگشت exit را تایپ کنید.
SELFTEST=خودآزمایی / حالت خودکار
MEDIA_NOTE=نکته: خود رسانه نصب از فهرست دیسک‌ها حذف شده است.
PRESS_ENTER=برای ادامه Enter بزنید.
INSTALL_LOG=لاگ نصب‌کننده
NO_DEVICE=هیچ دیسک هدفی انتخاب نشد.
BAD_DEVICE=دستگاه انتخاب‌شده یک دیسک معتبر نیست.
FIRMWARE_BIOS=سفت‌افزار شناسایی‌شده: BIOS قدیمی
FIRMWARE_UEFI=سفت‌افزار شناسایی‌شده: UEFI
ACT_DRYRUN=اجرای آزمایشی (بدون تغییر)
DRY_NOTE=نمایش برنامه بدون دست زدن به دیسک.
LOG_SAVED=یک نسخه از لاگ در /etc/sinux/install.log روی سیستم نصب‌شده ذخیره شد.
REBOOT_TITLE=آمادهٔ بوت به سینوکس
REBOOT_HINT=نصب کامل شد و سیستم زنده کاملاً در RAM اجرا میشود.\n\nهمین حالا USB نصب را جدا کنید، سپس OK بزنید.\n\nدستگاه بهصورت خودکار ریبوت میشود و ترمینال سینوکس بالا میآید. اگر USB را نکشید هم منوی نصبکننده سیستم نصبشده را شناسایی کرده و بوت میکند.
REBOOT_FAILED=ریبوت انجام نشد. دستگاه را خاموش کنید، USB نصب را جدا کنید و دوباره روشن کنید.
