 .PHONY: all iso run run-uefi run-bios run-serial test clean deps userspace disk
 
diff --git a/arch/x86_64/linker.ld b/arch/x86_64/linker.ld
index b1f9b4d..509a10a 100644
--- a/arch/x86_64/linker.ld
+++ b/arch/x86_64/linker.ld
@@ -1,20 +1,20 @@
 ENTRY(_start)
 
 SECTIONS {
+    /* AP trampoline must be linked below 1 MiB so its 16-bit absolute
+       relocations fit. Multiboot2 loads this segment at 0x7000. */
+    . = 0x7000;
+    .trampoline : AT(0x7000) {
+        _trampoline_start = .;
+        *(.trampoline .trampoline.*)
+        _trampoline_end = .;
+    }
+
     . = 1M;
     .multiboot2 : { KEEP(*(.multiboot2)) }
     .text   ALIGN(4K) : { *(.text .text.*) }
     .rodata ALIGN(4K) : { *(.rodata .rodata.*) }
     .data   ALIGN(4K) : { *(.data .data.*) }
-    
-    /* Trampoline section for AP startup - must be at physical address 0x7000 */
-    .trampoline 0x7000 : AT(0x7000) {
-        _trampoline_start = .;
-        *(.trampoline .trampoline.*)
-        _trampoline_end = .;
-        ASSERT((_trampoline_end - _trampoline_start) <= 0x1000, "Trampoline too large")
-    }
-    
     .bss    ALIGN(4K) : { *(COMMON) *(.bss .bss.*) }
     _kernel_end = .;
     /DISCARD/ : { *(.comment) *(.note*) *(.eh_frame*) }
