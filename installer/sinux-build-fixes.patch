 TARGET := $(BUILD)/kernel.elf
@@ -37,7 +38,8 @@ include kernel/proc/module.mk
 include kernel/fs/module.mk
 include kernel/syscall/module.mk
 include kernel/test/module.mk
-include kernel/scheduler/module.mk
